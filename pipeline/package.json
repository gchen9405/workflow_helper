{
  "name": "workflow-pipeline",
  "version": "0.1.0",
  "description": "Workflow pipeline: the end-to-end entry point — a flowchart image or free-text process description in, the narrator's human-readable improvement report out, with the preprocessor's schema and the recommender's ranked opportunities alongside.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "workflow-pipeline": "dist/cli.js"
  },
  "scripts": {
    "setup": "npm --prefix ../narrator run setup && npm --prefix ../narrator run build && npm install",
    "build": "tsc -p tsconfig.build.json",
    "build:browser": "node scripts/build-browser.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/cli.ts",
    "inbox": "tsx src/cli.ts --inbox",
    "check": "tsx src/cli.ts --check",
    "serve": "tsx examples/server.ts",
    "serve:browser": "tsx examples/browser-proxy.ts"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "workflow-narrator": "file:../narrator",
    "workflow-preprocessor": "file:../preprocessor",
    "workflow-recommender": "file:../recommender"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
