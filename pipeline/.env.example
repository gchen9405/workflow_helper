# The pipeline runs all three components (preprocessor, recommender,
# narrator) against the same internal OpenAI-compatible endpoint, through the
# preprocessor's client. One .env at the repo root serves everything —
# configuration is searched upward from the current directory.
#
# Verify with:  npm run check

# --- Required ---------------------------------------------------------------
LLM_ENDPOINT=https://llm.internal.example/v1
LLM_MODEL=your-deployment-name

# --- Optional ---------------------------------------------------------------
#LLM_API_KEY=
#LLM_MAX_TOKENS=8192
#LLM_JSON_MODE=off

# --- Optional vision/text split (flowchart images) ---------------------------
# Only the two preprocessor calls that carry an image go to the vision model;
# everything else — extraction, clarification, profiling, the summary — runs
# on the main model above.
#LLM_VISION_MODEL=your-vlm-deployment
#LLM_VISION_ENDPOINT=
#LLM_VISION_API_KEY=

# --- Reference HTTP server (examples/server.ts) ------------------------------
#PORT=8787
