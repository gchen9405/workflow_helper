# Copy to .env and fill in. The CLI loads the nearest .env automatically
# (searching upward from the current directory); real environment variables
# always win over anything in this file.
#
# Verify with:  npx tsx src/cli.ts --check

# --- Required ---------------------------------------------------------------

# Base URL of your internal OpenAI-compatible chat-completions endpoint.
# "/chat/completions" is appended when it is not already there.
LLM_ENDPOINT=https://llm.internal.example/v1

# Model / deployment name your gateway expects.
LLM_MODEL=your-deployment-name

# --- Optional ---------------------------------------------------------------

# Sent as "Authorization: Bearer <key>". Omit if your gateway doesn't need it.
#LLM_API_KEY=

# Max output tokens per call (default 8192). Raise if extraction gets truncated
# on large flowcharts.
#LLM_MAX_TOKENS=8192

# Set to "off" if your gateway rejects response_format: {"type":"json_object"}.
#LLM_JSON_MODE=off

# --- Optional vision/text split ---------------------------------------------
# Routes the two calls that carry an image (triage + normalization of flowchart
# images) to a VLM, and everything else — extraction and every clarification
# round — to the cheaper main model above. Setting any one of these activates
# the split; the others fall back to the main settings.

#LLM_VISION_MODEL=your-vlm-deployment
#LLM_VISION_ENDPOINT=
#LLM_VISION_API_KEY=
