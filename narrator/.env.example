# The narrator talks to the same internal OpenAI-compatible endpoint as the
# preprocessor and recommender, through the same client. One .env at the
# repo root serves all three components — configuration is searched upward
# from the current directory.
LLM_ENDPOINT=https://llm.internal.example/v1
LLM_API_KEY=
LLM_MODEL=your-deployment-name
# LLM_MAX_TOKENS=8192
# LLM_JSON_MODE=off
