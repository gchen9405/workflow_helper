{
  "name": "workflow-narrator",
  "version": "0.1.0",
  "description": "Workflow narrator: turns the recommender's result JSON into a coherent, human-readable report \u2014 a deterministic body with a model-written summary on top.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    }
  },
  "bin": {
    "workflow-narrator": "dist/cli.js"
  },
  "scripts": {
    "setup": "npm --prefix ../recommender run setup && npm --prefix ../recommender run build && npm install",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx src/cli.ts",
    "check": "tsx src/cli.ts --check"
  },
  "engines": {
    "node": ">=18.17"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "workflow-preprocessor": "file:../preprocessor",
    "workflow-recommender": "file:../recommender",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
